<tr>
    <td><%= user.name %></td>

    <td><%= user.email %></td>

    <td>
        <% if (user.isAdmin) { %>
            <span class="badge bg-success">Admin</span>
        <% } else { %>
            <span class="badge bg-secondary">User</span>
        <% } %>
    </td>

    <td>
        <% if (user.isAdmin) { %>
            <a href="/demote/<%= user._id %>" class="btn btn-warning btn-sm">
                Demote to User
            </a>
        <% } else { %>
            <a href="/promote/<%= user._id %>" class="btn btn-primary btn-sm">
                Promote to Admin
            </a>
        <% } %>
    </td>
</tr>